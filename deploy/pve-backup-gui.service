[Unit]
Description=PVE Backup GUI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pve-backup-gui
Group=pve-backup-gui
StateDirectory=pve-backup-gui
StateDirectoryMode=0700
EnvironmentFile=/etc/pve-backup-gui/secret.env
ExecStart=/usr/local/bin/pve-backup-gui -config /etc/pve-backup-gui/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
